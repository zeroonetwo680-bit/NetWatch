# ── Network layer mode switch ─────────────────────────────────────────
# simulated: in-memory virtual network (development, demos, tests)
# mikrotik:  real RouterOS API connection (full features: usage, queues, blocking)
# lan:       local network discovery via ARP/ping (any router: Huawei, TP-Link, etc.)
NETWORK_MODE=simulated

# ── LAN discovery (used only when NETWORK_MODE=lan) ───────────────────
# Subnet to sweep for devices (leave empty for automatic detection)
LAN_SUBNET=
LAN_PING_SWEEP=true
LAN_SWEEP_INTERVAL_MS=120000
LAN_REVERSE_DNS=true
LAN_UPNP=true

# ── MikroTik connection (used only when NETWORK_MODE=mikrotik) ───────
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=

# ── Poller ────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=10000
SAMPLE_RETENTION_DAYS=7
SIM_DEVICE_COUNT=10

# ── Database ──────────────────────────────────────────────────────────
DATABASE_PATH=./data/netwatch.db

# ── Auth ──────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-32-chars-minimum-long-secret
SESSION_TTL_HOURS=24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
DEMO_USER_USERNAME=user
DEMO_USER_PASSWORD=user123
